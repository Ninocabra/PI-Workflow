<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>
         <b>PI Workflow Repository</b> - Automated and optimized PixInsight processing workflow script.
      </p>
   </description>
   <platform os="all" arch="noarch" version="1.8.8:1.9.3">
      <package fileName="PI-Workflow-193.zip"
               sha1="3a05899a15f5789706e068a6fe7ce361efdb7238"
               type="script"
               releaseDate="20260608">
         <title>PI Workflow Script Suite (PixInsight 1.9.3 and earlier)</title>
         <description>
             <p>
                PI Workflow - frozen build for PixInsight 1.9.3 and earlier (SpiderMonkey runtime). Maintained on the 1.9.4+ line only; this package is kept stable for legacy cores.
             </p>
         </description>
      </package>
   </platform>
   <platform os="all" arch="noarch" version="1.9.4:1.9.9">
      <package fileName="PI-Workflow-194.zip"
               sha1="adb448f8d7c0b5f75d927c0d0e53f80d9a9df40f"
               type="script"
               releaseDate="20260720">
         <title>PI Workflow Script Suite (PixInsight 1.9.4+)</title>
         <description>
             <p>
                PI Workflow 2.0 — This major release rebuilds the script on a new modular engine and adds two new tabs (Image Enhancement and Configuration), Continuum Subtraction, batch "Apply all" operations, a bilingual EN/ES interface, and support for the new SyQon V3 engines (Starless and Parallax).
             </p>
         </description>
      </package>
   </platform>
</xri>
